<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Dashboard View (proposal mockup 04) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.antonio.sportstournamentclient.dashboard.DashboardController">
    <left>
        <fx:include source="../core/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page" spacing="22">
            <VBox>
                <Label text="Dashboard" styleClass="page-title"/>
                <Label fx:id="welcomeLabel" styleClass="page-subtitle"/>
            </VBox>

            <!-- stat cards -->
            <HBox spacing="18">
                <VBox styleClass="card" spacing="10" prefWidth="250">
                    <Label fx:id="teamsTitleLabel" text="Teams" styleClass="field-label"/>
                    <Label fx:id="teamsCountLabel" text="-" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="card" spacing="10" prefWidth="250">
                    <Label text="Role" styleClass="field-label"/>
                    <Label fx:id="roleLabel" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="card" spacing="10" prefWidth="320">
                    <Label text="Account" styleClass="field-label"/>
                    <Label fx:id="emailLabel" styleClass="field-value" wrapText="true"/>
                </VBox>
            </HBox>

            <!-- quick actions -->
            <VBox styleClass="card" spacing="12" maxWidth="420">
                <Label text="Quick Actions" styleClass="card-title"/>
                <Button fx:id="createTeamButton" text="+ Create Team" onAction="#handleCreateTeam"
                        styleClass="primary-button" maxWidth="Infinity"/>
                <Button text="View Teams" onAction="#handleViewTeams" styleClass="secondary-button" maxWidth="Infinity"/>
                <Button fx:id="usersButton" text="Manage Users" onAction="#handleUsers"
                        styleClass="secondary-button" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
