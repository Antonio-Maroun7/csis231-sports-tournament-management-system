<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- "Registered Teams" panel, included in the Tournament Details View (mockup 09) -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.antonio.sportstournamentclient.registration.RegisteredTeamsController"
      styleClass="card" spacing="12" VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Registered Teams" styleClass="section-title"/>
            <Label fx:id="summaryLabel" text="-" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="approveButton" text="Approve" onAction="#handleApprove" styleClass="primary-button"/>
        <Button fx:id="rejectButton" text="Reject" onAction="#handleReject" styleClass="danger-button"/>
        <Button fx:id="withdrawButton" text="Withdraw" onAction="#handleWithdraw" styleClass="secondary-button"/>
        <Button fx:id="registerButton" text="Register Team" onAction="#handleRegister" styleClass="primary-button"/>
        <Button text="Refresh" onAction="#loadRegistrations" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="registrationTable" VBox.vgrow="ALWAYS" prefHeight="240">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="No team registered yet"/></placeholder>
        <columns>
            <TableColumn fx:id="teamColumn" text="Team" prefWidth="260"/>
            <TableColumn fx:id="managerColumn" text="Manager" prefWidth="220"/>
            <TableColumn fx:id="registeredColumn" text="Registered At" prefWidth="160"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
        </columns>
    </TableView>

    <Label fx:id="panelMessageLabel" wrapText="true"/>
</VBox>
