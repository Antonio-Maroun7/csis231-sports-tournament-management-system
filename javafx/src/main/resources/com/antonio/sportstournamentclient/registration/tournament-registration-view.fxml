<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tournament Registration View (proposal mockup 10) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.antonio.sportstournamentclient.registration.TournamentRegistrationController">
    <left>
        <fx:include source="../core/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page" spacing="18">
            <!-- header -->
            <VBox>
                <Label text="Tournament Registration" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" text="Register a team in an open tournament" styleClass="page-subtitle"/>
            </VBox>

            <!-- registration form card (mockup 10) -->
            <VBox styleClass="card" spacing="10" maxWidth="640">
                <Label text="Register Team in Tournament" styleClass="section-title"/>

                <Label text="Tournament" styleClass="field-label"/>
                <ComboBox fx:id="tournamentCombo" promptText="Choose an open tournament" maxWidth="Infinity"/>

                <Label text="Team" styleClass="field-label"/>
                <ComboBox fx:id="teamCombo" promptText="Choose one of your teams" maxWidth="Infinity"/>

                <Label text="Your registration starts as PENDING until the tournament's organizer approves it. After approval, you can propose venues for your matches."
                       styleClass="info-box" wrapText="true" maxWidth="Infinity"/>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-button" prefWidth="140"/>
                    <Button fx:id="registerButton" text="Register Team" onAction="#handleRegister"
                            styleClass="primary-button" prefWidth="170"/>
                </HBox>

                <Label fx:id="formMessageLabel" wrapText="true"/>
            </VBox>

            <!-- my registrations -->
            <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="My Registrations" styleClass="section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="withdrawButton" text="Withdraw" onAction="#handleWithdraw" styleClass="secondary-button"/>
                </HBox>
                <TableView fx:id="myRegistrationsTable" VBox.vgrow="ALWAYS" prefHeight="200">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="Your teams are not registered in any tournament yet"/></placeholder>
                    <columns>
                        <TableColumn fx:id="tournamentColumn" text="Tournament" prefWidth="260"/>
                        <TableColumn fx:id="teamColumn" text="Team" prefWidth="220"/>
                        <TableColumn fx:id="registeredColumn" text="Registered At" prefWidth="160"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
                    </columns>
                </TableView>
                <Label fx:id="messageLabel" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
