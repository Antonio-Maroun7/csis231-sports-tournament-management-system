<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tournaments View (proposal mockup 08) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.antonio.sportstournamentclient.tournament.TournamentsController">
    <left>
        <fx:include source="../core/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page" spacing="18">
            <!-- header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Tournaments" styleClass="page-title"/>
                    <Label text="Browse tournaments and follow their status" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="createButton" text="+ Create Tournament" onAction="#handleCreate" styleClass="primary-button"/>
            </HBox>

            <!-- toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" prefWidth="170"/>
                <Button text="Open Details" onAction="#handleOpenDetails" styleClass="secondary-button"/>
                <Button fx:id="editButton" text="Edit" onAction="#handleEdit" styleClass="secondary-button"/>
                <Button fx:id="advanceButton" text="Advance Status" onAction="#handleAdvance" styleClass="primary-button"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#loadTournaments" styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="tournamentTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="No tournaments"/></placeholder>
                <columns>
                    <TableColumn fx:id="nameColumn" text="Tournament" prefWidth="260"/>
                    <TableColumn fx:id="organizerColumn" text="Organizer" prefWidth="190"/>
                    <TableColumn fx:id="startColumn" text="Start" prefWidth="130"/>
                    <TableColumn fx:id="endColumn" text="End" prefWidth="130"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="160"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
