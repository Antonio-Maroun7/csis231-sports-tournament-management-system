<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Teams View (proposal mockup 05) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.antonio.sportstournamentclient.team.TeamsController">
    <left>
        <fx:include source="../core/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page" spacing="18">
            <!-- header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Teams" styleClass="page-title"/>
                    <Label fx:id="subtitleLabel" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="createButton" text="+ Create Team" onAction="#handleCreate" styleClass="primary-button"/>
            </HBox>

            <!-- toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="Open Details" onAction="#handleOpenDetails" styleClass="secondary-button"/>
                <Button fx:id="editButton" text="Edit" onAction="#handleEdit" styleClass="secondary-button"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#loadTeams" styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="teamTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="No teams yet"/></placeholder>
                <columns>
                    <TableColumn fx:id="nameColumn" text="Team Name"/>
                    <TableColumn fx:id="managerColumn" text="Manager"/>
                    <TableColumn fx:id="createdColumn" text="Created"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
