<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.antonio.sportstournamentclient.team.TeamsController">
 <left><fx:include source="../core/sidebar.fxml"/></left><center><VBox spacing="12" styleClass="content">
  <Label text="Teams" styleClass="title"/><Label text="Manage tournament teams, managers, and registration dates."/>
  <HBox spacing="8"><Button text="Create team" onAction="#create"/><Button text="Edit selected" onAction="#edit"/><Button text="Open details" onAction="#open"/><Button text="Delete" onAction="#delete"/><Button text="Refresh" onAction="#load"/><Label fx:id="status"/></HBox>
  <TableView fx:id="teams" VBox.vgrow="ALWAYS"><columns>
   <TableColumn fx:id="nameColumn" text="Team name" prefWidth="240"/><TableColumn fx:id="managerColumn" text="Manager" prefWidth="220"/><TableColumn fx:id="dateColumn" text="Created" prefWidth="210"/><TableColumn fx:id="idColumn" text="ID" prefWidth="90"/>
  </columns></TableView>
 </VBox></center>
</BorderPane>
