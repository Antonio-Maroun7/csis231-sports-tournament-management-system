<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Two-Factor Verification (proposal mockup 02): the 6-digit code is sent by EMAIL -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.antonio.sportstournamentclient.auth.TwoFactorController"
           styleClass="auth-side">

    <VBox styleClass="auth-card" spacing="12" alignment="TOP_CENTER" maxWidth="580" maxHeight="-Infinity">
        <Label text="Two-Factor Authentication" styleClass="auth-title"/>
        <Label fx:id="subtitleLabel" text="Enter the 6-digit code we sent to your email."
               styleClass="page-subtitle" wrapText="true"/>

        <Label text="2FA" styleClass="twofa-icon">
            <VBox.margin><Insets top="14" bottom="14"/></VBox.margin>
        </Label>

        <!-- the six digit boxes are created by TwoFactorController -->
        <HBox fx:id="codeBox" spacing="12" alignment="CENTER"/>

        <Button fx:id="verifyButton" text="Verify Code" onAction="#handleVerify" defaultButton="true"
                styleClass="primary-button" maxWidth="Infinity">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Button>
        <Hyperlink fx:id="resendLink" text="Resend code" onAction="#handleResend" styleClass="link-button"/>
        <Label fx:id="expiryLabel" styleClass="auth-hint"/>
        <Label fx:id="messageLabel" wrapText="true"/>
        <Hyperlink text="Back to login" onAction="#handleBackToLogin" styleClass="link-button"/>
    </VBox>
</StackPane>
