<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Users View (Administrator only) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.antonio.sportstournamentclient.user.UsersController">
    <left>
        <fx:include source="../core/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page" spacing="18">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Users" styleClass="page-title"/>
                    <Label text="Manage accounts and roles" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="createButton" text="+ Create User" onAction="#handleCreate" styleClass="primary-button"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#loadUsers" styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="No users"/></placeholder>
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name"/>
                    <TableColumn fx:id="emailColumn" text="Email"/>
                    <TableColumn fx:id="roleColumn" text="Role"/>
                    <TableColumn fx:id="twoFactorColumn" text="2FA"/>
                    <TableColumn fx:id="createdColumn" text="Created"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
