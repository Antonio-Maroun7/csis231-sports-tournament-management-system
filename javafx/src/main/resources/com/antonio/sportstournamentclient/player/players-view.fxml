<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Players View (proposal mockup 07) -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.antonio.sportstournamentclient.player.PlayersController">
    <left>
        <fx:include source="../core/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page" spacing="18">
            <!-- header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Players" styleClass="page-title"/>
                    <Label fx:id="subtitleLabel" text="Choose a team" styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="addButton" text="+ Add Player" onAction="#handleAdd" styleClass="primary-button"/>
            </HBox>

            <!-- toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Team" styleClass="field-label"/>
                <ComboBox fx:id="teamCombo" prefWidth="260" promptText="Select a team"/>
                <Button fx:id="editButton" text="Edit" onAction="#handleEdit" styleClass="secondary-button"/>
                <Button fx:id="removeButton" text="Remove" onAction="#handleRemove" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#loadPlayers" styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="playerTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="No players on this team yet"/></placeholder>
                <columns>
                    <TableColumn fx:id="jerseyColumn" text="Jersey #" prefWidth="100" maxWidth="140"/>
                    <TableColumn fx:id="nameColumn" text="Player Name" prefWidth="300"/>
                    <TableColumn fx:id="teamColumn" text="Team" prefWidth="250"/>
                    <TableColumn fx:id="positionColumn" text="Position" prefWidth="200"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
