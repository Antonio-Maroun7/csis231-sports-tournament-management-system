<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Roster panel, included in the Team Details View (mockup 06) -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.antonio.sportstournamentclient.player.RosterController"
      styleClass="card" spacing="12" VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Players" styleClass="section-title"/>
            <Label fx:id="rosterSummaryLabel" text="Roster summary: -" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="editPlayerButton" text="Edit" onAction="#handleEditPlayer" styleClass="secondary-button"/>
        <Button fx:id="removePlayerButton" text="Remove" onAction="#handleRemovePlayer" styleClass="danger-button"/>
        <Button fx:id="addPlayerButton" text="+ Add Player" onAction="#handleAddPlayer" styleClass="primary-button"/>
    </HBox>

    <TableView fx:id="playerTable" VBox.vgrow="ALWAYS" prefHeight="260">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="No players on this team yet"/></placeholder>
        <columns>
            <TableColumn fx:id="jerseyColumn" text="#" prefWidth="80" maxWidth="120"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="300"/>
            <TableColumn fx:id="positionColumn" text="Position" prefWidth="200"/>
        </columns>
    </TableView>

    <Label fx:id="rosterMessageLabel" wrapText="true"/>
</VBox>
