# Local secrets for the Spring Boot API. This file is ignored by Git: NEVER commit it.
# Format: KEY=value (no quotes, no spaces around the value)
DB_URL=jdbc:postgresql://localhost:5432/sports_tournament_db
DB_USERNAME=postgres
DB_PASSWORD=change_me
# Gmail address that sends the 2FA codes + its 16-letter App Password (written WITHOUT spaces)
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=change_me
# JWT signing key: a random string of AT LEAST 32 characters
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
JWT_EXPIRATION_MS=7200000
# Optional: creates the first ADMIN at startup if no ADMIN exists yet
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
